# Node 24+. Never commit real credentials or health data.
API_PORT=8787
DB_FILE=data/crew-health.sqlite
# Optional cloud rewording; leave empty for local-only operation.
GEMINI_API_KEY=
# Optional model override for the rewording service.
# GEMINI_MODEL=your-model-id

# Experimental local AI. No model is downloaded automatically.
# Use a verified locally installed Ollama model name, not a Hugging Face repo ID.
# Official MedGemma releases checked: 4B and 27B; no official 7B found.
LOCAL_AI_ENABLED=false
LOCAL_AI_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=
LOCAL_AI_TIMEOUT_MS=90000

# Selected conversational model. Explicit setup downloads/enables it after consent.
COMPANION_AI_ENABLED=false
COMPANION_AI_URL=http://127.0.0.1:11434
COMPANION_AI_MODEL=qwen3:1.7b
COMPANION_AI_TIMEOUT_MS=90000

# Local STT/TTS sidecar. Weights are not bundled; explicit setup installs them
# only after separate voice/license consent (or use --skip-voice).
VOICE_ENABLED=false
VOICE_STT_URL=http://127.0.0.1:8001
VOICE_STT_MODEL=
VOICE_TTS_URL=http://127.0.0.1:8001
VOICE_TTS_MODEL=
VOICE_TTS_VOICE=
VOICE_TIMEOUT_MS=60000
# For npm run voice:server, use a Python venv with tools/voice/requirements.txt.
VOICE_PYTHON=python3
VOICE_PORT=8001
STT_MODEL_DIR=
TTS_MODEL_PATH=
